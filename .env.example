# Copy outside Git (e.g. deploy/.env) or export these in the shell.
SHESHTKEH_IMAGE=sheshtkeh-beshtkeh:0.1.0-beta
SHESHTKEH_PORT=8094
SHESHTKEH_BIND_ADDRESS=127.0.0.1
# Local HTTP only. Set true for HTTPS deployments.
SHESHTKEH_SECURE_COOKIES=false
SHESHTKEH_ALLOW_INSECURE_HTTP=true
SHESHTKEH_ADMIN_USERNAME=admin
# Empty disables admin authentication. Supply a strong private value locally.
SHESHTKEH_ADMIN_PASSWORD=
SHESHTKEH_RELEASE=0.1.0-beta
